@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav
@inject GameStateService GameSvc
@implements IDisposable

@inherits LayoutComponentBase

<div class="app-shell">
    <header class="cf-header">
        <div>
            <div style="font-size:.7rem;opacity:.7;font-weight:500;letter-spacing:.08em">CASHFLOW 202</div>
            <h1>@(string.IsNullOrEmpty(GameSvc.State.PlayerName) ? "Tracker" : GameSvc.State.PlayerName)</h1>
        </div>
        <div style="display:flex;align-items:center;gap:.5rem">
            @if (!string.IsNullOrEmpty(GameSvc.State.Profession.Name))
            {
                <span style="font-size:.72rem;opacity:.8;background:rgba(255,255,255,.15);padding:.2rem .5rem;border-radius:12px">
                    @GameSvc.State.Profession.Name
                </span>
            }
        </div>
    </header>

    <div class="page-content">
        @Body
    </div>

    <nav class="tab-bar" role="navigation" aria-label="Main navigation">
        <button class="tab-btn @(IsActive("/") ? "active" : "")" @onclick='() => Nav.NavigateTo("/")'
                title="Setup" aria-label="Setup">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
            Setup
        </button>

        <button class="tab-btn @(IsActive("/statement") ? "active" : "")"
                @onclick='() => Nav.NavigateTo("/statement")' title="Financials" aria-label="Financial Statement">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
            Financials
        </button>

        <button class="tab-btn @(IsActive("/deals") ? "active" : "")"
                @onclick='() => Nav.NavigateTo("/deals")' title="Deals" aria-label="Deals">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9,22 9,12 15,12 15,22"/>
            </svg>
            Deals
        </button>

        <button class="tab-btn @(IsActive("/options") ? "active" : "")"
                @onclick='() => Nav.NavigateTo("/options")' title="Options" aria-label="Options Worksheet">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            Options
        </button>

        <button class="tab-btn @FastTrackTabClass()"
                @onclick="NavigateToFastTrack" title="Fast Track" aria-label="Fast Track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            Fast Track
        </button>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        GameSvc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        GameSvc.OnChange -= StateHasChanged;
    }

    private bool IsActive(string href)
    {
        var uri = new Uri(Nav.Uri);
        var path = uri.AbsolutePath.TrimEnd('/');
        return href == "/" ? path == "" || path == "/" : path == href;
    }

    private string FastTrackTabClass()
    {
        var active = IsActive("/fasttrack") ? "active" : "";
        var glow = GameSvc.State.CanEnterFastTrack ? "ft-available" : "";
        return $"{active} {glow}".Trim();
    }

    private void NavigateToFastTrack()
    {
        Nav.NavigateTo("/fasttrack");
    }
}
