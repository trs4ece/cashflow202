{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_framework/*", "/service-worker.js", "/service-worker-assets.js", "/*.{png,ico,svg,jpg,gif,webp,woff,woff2,ttf,css,js}"]
  },
  "routes": [
    {
      "route": "/_framework/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/manifest.json",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/service-worker.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/service-worker-assets.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".wasm": "application/wasm"
  }
}
