<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(CashFlow202.Web.Client._Imports).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(CashFlow202.Web.Client.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(CashFlow202.Web.Client.Layout.MainLayout)">
            <Pages.NotFound />
        </LayoutView>
    </NotFound>
</Router>
