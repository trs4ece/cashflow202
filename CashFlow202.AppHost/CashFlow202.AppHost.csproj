<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CashFlow202.AppHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire ships as NuGet packages on .NET 10 (no workload required) -->
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashFlow202.Web.Server\CashFlow202.Web.csproj" />
  </ItemGroup>

</Project>
